# Copy this file to .env.local and fill in the values. .env.local is gitignored and must never
# be committed. Put secrets in through the editor, never through chat or the terminal.

# Required. Anthropic API key used by every AI job (tag mapping, choosing picks, card writing,
# checks). Production uses a separate, spend-capped key stored as a Vercel secret.
ANTHROPIC_API_KEY=

# Optional. Hardcover API token for the reader-tag book pool. Without it the engine runs on
# Open Library alone.
HARDCOVER_API_TOKEN=

# Optional, local only. Set to 1 to write a debug trace of each request to .local/traces/.
# Traces hold the full taste description; never share them. Ignored on Vercel.
ENGINE_TRACE=

# Optional. Try a different model for one AI job without editing code (decision 14.3). Leave
# empty to use the default in lib/ai/slots.ts. The model must be listed in lib/ai/models.ts;
# an unknown name is ignored with a warning. Prove a change with that job's eval first.
AI_SLOT_TAG_MAPPING=
AI_SLOT_SELECTION=
AI_SLOT_CARD_WRITING=
AI_SLOT_SHORTENING=
AI_SLOT_DESCRIPTION_CHECK=
