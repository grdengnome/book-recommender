# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# local logs and debug traces the app writes while running (search log, Hardcover failures,
# ENGINE_TRACE=1 traces). They can hold real readers' answers: never committed.
/.local/

# eval run output (raw results; summaries go in evals/reports/ or docs/quality/eval-log.md)
/evals/results/

# experiment run output: kept local. Evidence files that back a past decision are
# force-added (git add -f) and listed in experiments/README.md.
/experiments/*.json
/experiments/traces/
/experiments/experiments/

# cover research: cover images, the pages that display them, and working files
/experiments/cover-research/samples/
/experiments/cover-research/samples-2x/
/experiments/cover-research/upscaled/
/experiments/cover-research/work/
/experiments/cover-research/contact-sheet.html
/experiments/cover-research/reveal-preview.html
/experiments/cover-research/upscale-compare.html
/experiments/cover-research/upscale-blind.html

# typescript
*.tsbuildinfo
next-env.d.ts
