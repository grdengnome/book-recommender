# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# scratchpad run output (regenerated per eval run — the driver script itself is
# tracked, its output isn't)
# Note: some files here (query-log.json, pool-source-attribution.json, etc.)
# have been force-added (git add -f) despite this rule anyway, because they
# captured real diagnostic findings worth preserving in git history.
/scratchpad/*.json

# typescript
*.tsbuildinfo
next-env.d.ts
